<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/actions_title">

    <PreferenceCategory
        android:key="actions_key">

        <SwitchPreferenceCompat
            android:key="gesture_chop_chop"
            android:defaultValue="true"
            android:title="@string/chop_chop_gesture_title"
            android:summary="@string/chop_chop_gesture_summary"
            android:icon="@drawable/ic_settings_chop" />

        <SwitchPreferenceCompat
            android:key="gesture_ir_silencer"
            android:defaultValue="false"
            android:title="@string/hand_wave_silencer_title"
            android:summary="@string/hand_wave_silencer_summary"
            android:icon="@drawable/ic_settings_wave" />

        <SwitchPreferenceCompat
            android:key="gesture_flip_to_mute"
            android:defaultValue="false"
            android:title="@string/flip_to_mute_title"
            android:summary="@string/flip_to_mute_summary"
            android:icon="@drawable/ic_settings_flip" />

        <SwitchPreferenceCompat
            android:key="gesture_lift_to_silence"
            android:defaultValue="false"
            android:title="@string/lift_to_silence_title"
            android:summary="@string/lift_to_silence_summary"
            android:icon="@drawable/ic_settings_pick" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="display_boost_category"
        android:title="@string/display_boost_category">

        <SwitchPreferenceCompat
            android:key="hbm_boost_enabled"
            android:defaultValue="false"
            android:title="@string/hbm_boost_title"
            android:summary="@string/hbm_boost_summary" />

        <SwitchPreferenceCompat
            android:key="dc_dimming_enabled"
            android:defaultValue="false"
            android:title="@string/dc_dimming_title"
            android:summary="@string/dc_dimming_summary" />

        <SwitchPreferenceCompat
            android:key="edge_rejection_enabled"
            android:defaultValue="true"
            android:title="@string/edge_rejection_title"
            android:summary="@string/edge_rejection_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="performance_category"
        android:title="@string/performance_category">

        <ListPreference
            android:key="perf_profile"
            android:defaultValue="balanced"
            android:entries="@array/perf_profile_entries"
            android:entryValues="@array/perf_profile_values"
            android:title="@string/perf_profile_title"
            android:summary="%s" />

        <SwitchPreferenceCompat
            android:key="touch_gaming_enabled"
            android:defaultValue="false"
            android:title="@string/touch_gaming_title"
            android:summary="@string/touch_gaming_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="audio_boost_category"
        android:title="@string/audio_boost_category">

        <ListPreference
            android:key="earpiece_gain_boost"
            android:defaultValue="0"
            android:entries="@array/audio_gain_entries"
            android:entryValues="@array/audio_gain_values"
            android:title="@string/earpiece_boost_title"
            android:summary="%s" />

        <ListPreference
            android:key="speaker_gain_boost"
            android:defaultValue="0"
            android:entries="@array/audio_gain_entries"
            android:entryValues="@array/audio_gain_values"
            android:title="@string/speaker_boost_title"
            android:summary="%s" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="battery_health_category"
        android:title="@string/battery_health_category">

        <SwitchPreferenceCompat
            android:key="charge_limit_80_enabled"
            android:defaultValue="false"
            android:title="@string/charge_limit_80_title"
            android:summary="@string/charge_limit_80_summary" />

    </PreferenceCategory>

</PreferenceScreen>
